# Fluir Customer — dart-defines. Copy to `.env` (git-ignored) and fill in.
# Run: flutter run --dart-define-from-file=.env
# Never commit real tokens. Every value below is a placeholder or a public demo value.

# Mapbox public access token (maps, geocoding, directions).
ACCESS_TOKEN=

# --- Payments (unchanged; payment phase pending) ----------------------------
# localSandbox = debug-only direct gateway; anything else = on-device simulated vault.
FLUIR_PAYMENT_GATEWAY_BASE_URL=
FLUIR_AZUL_COMPANY_ID=
FLUIR_PAYMENT_MODE=

# --- Trip backend (leave empty to keep the simulated trip flow) -------------
# Demo backend, Android emulator:        http://10.0.2.2:8090/api/  +  ws://10.0.2.2:8090
# Demo backend, phone via `adb reverse`: http://127.0.0.1:8090/api/ +  ws://127.0.0.1:8090
# Real backend:                          https://api.fluir.us/api/  +  wss://ws.api.fluir.us
# Plain http:// and ws:// are accepted in debug builds only.
FLUIR_API_BASE_URL=
FLUIR_WS_BASE_URL=
# Public realtime app key (demo backend: fluir-demo-key).
FLUIR_WS_APP_KEY=
FLUIR_DEMO_MODE=false
# Reserved: simulated device location on emulators.
FLUIR_DEMO_GPS_ENABLED=false

# --- Demo customer sign-in (debug builds + FLUIR_DEMO_MODE=true + backend) --
# Seeded demo customer of fluir-demo-backend and the backend's DEMO_OTP_CODE.
# Shows "Entrar como cliente demo" on onboarding. Keep the real values in a
# git-ignored file (e.g. .env.demo) and pass both files:
#   flutter run --dart-define-from-file=.env --dart-define-from-file=.env.demo
FLUIR_DEMO_CUSTOMER_PHONE=
FLUIR_DEMO_CUSTOMER_COUNTRY=DO
FLUIR_DEMO_OTP=
